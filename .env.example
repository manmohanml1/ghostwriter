# Ghostwriter Environment Variables & Cloud Integration
# Copy this file to .env.local for local overrides. NEVER commit .env.local to Git.

# Optional Supabase Backend (Multi-Device Story Sync & Authentication)
# Get your credentials at https://supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only AI provider credentials used by /api/ai. Never expose these to Angular.
# Google Gemini API Key (Gemini 2.5 Flash / Pro): https://aistudio.google.com
GEMINI_API_KEY=

# Groq API Key (Llama 3.3 70B Versatile): https://console.groq.com
GROQ_API_KEY=

# Server-side authentication verification for the AI proxy
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# App Environment Configuration
NODE_ENV=development
PORT=4200
