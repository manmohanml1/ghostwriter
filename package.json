{
  "name": "ghostwriter-monorepo",
  "version": "0.5.3",
  "description": "Ghostwriter — AI Co-Writing Studio with Interactive Branching Narratives",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspace=apps/web run test",
    "build": "npm --workspace=apps/web run build",
    "check:migrations": "node scripts/validate-supabase-migrations.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check:migrations && npm test && npm run build && npm run audit:production",
    "start": "npm --workspace=apps/web run start",
    "start:web": "npm run start --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web"
  },
  "updatedAt": "2026-08-24T01:05:19.265Z"
}
